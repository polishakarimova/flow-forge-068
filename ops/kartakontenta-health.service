[Unit]
Description=Check Karta Kontenta app and backups
After=network-online.target
[Service]
Type=oneshot
UMask=0077
EnvironmentFile=/etc/kartakontenta/runtime.env
ExecStart=/usr/bin/node /opt/kartakontenta/current/ops/health.mjs --run
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/kartakontenta-health
