[Unit]
Description=Karta Kontenta app
After=network-online.target
[Service]
Type=simple
User=karta
Group=karta
WorkingDirectory=/opt/kartakontenta/current
Environment=NODE_ENV=production
ExecStart=/usr/bin/node server/telegram-auth-server.mjs
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
StateDirectory=kartakontenta
[Install]
WantedBy=multi-user.target
